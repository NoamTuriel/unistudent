{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_tests.py\"",
            "timeout": 300,
            "statusMessage": "Running tests..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/privacy_guard.py\"",
            "statusMessage": "Checking for personal info..."
          },
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/privacy_guard.py\"",
            "statusMessage": "Checking for personal info..."
          }
        ]
      }
    ]
  }
}
